# Datasets not committed
data/bossbase/

# Python cache & virtual environments
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
venv/
.venv/
env/
.env

# Private keys: never commit
keys/rsa_private.pem
paper/keys_experiment/

# Temporary outputs (images, PDFs, scratch folders) anywhere...
exp_tmp*/
tests_tmp*/
*.png
*.jpg
*.pdf
*.npz
# ...except the test images and the final paper figures
!data/**/*.png
!paper/final/*.png
!paper/final/*.pdf

# LaTeX build files
paper/manuscript/*.aux
paper/manuscript/*.log
paper/manuscript/*.out
paper/manuscript/*.toc
paper/manuscript/*.synctex.gz
